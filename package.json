{
  "name": "agent-evals",
  "version": "0.1.0-dev",
  "description": "Deterministic evaluation harness for LLM agents, with a calibrated judge that can act as a CI gate.",
  "keywords": ["evals", "llm", "agents", "testing", "ci", "jev", "typesafe"],
  "license": "MIT",
  "author": "Mariano Berton",
  "repository": { "type": "git", "url": "git+https://github.com/marianoberton/agent-evals.git" },
  "homepage": "https://github.com/marianoberton/agent-evals#readme",
  "bugs": "https://github.com/marianoberton/agent-evals/issues",
  "type": "module",
  "engines": { "node": ">=20.10" },
  "bin": { "agent-evals": "./dist/cli.js" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "evals": "tsx src/cli.ts run examples/echo-agent/echo.suite.ts",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "picocolors": "^1.1.1",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.8",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "peerDependencies": {
    "vitest": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "vitest": { "optional": true }
  },
  "packageManager": "pnpm@9.12.3"
}
